{
  "name": "darttracker",
  "version": "1.1.0",
  "description": "Lokale Dart-Tracking-App mit Handy-Fernbedienung",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.linke.darttracker",
    "productName": "DartTracker",
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json",
      "!data/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DartTracker-portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lucccccccca",
        "repo": "darttracker",
        "releaseType": "release"
      }
    ]
  },
  "author": "Lucccccccca",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucccccccca/darttracker.git"
  }
}
